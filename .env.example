# Docker Compose reads this file after copying it to .env.
# Empty token is suitable for a local-only lab. Set a random token before sharing access.
EVENTLAB_API_TOKEN=
EVENTLAB_ORIGINS=http://localhost:8080,http://localhost:5173
# Native development: set these variables in your shell; Uvicorn does not load .env automatically.
# EVENTLAB_DB=data/eventlab.db
# VITE_API_BASE=   # empty uses the same-origin reverse proxy
