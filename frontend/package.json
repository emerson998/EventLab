{
  "name": "eventlab-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts playwright.config.ts e2e",
    "format": "prettier --write src vite.config.ts vitest.config.ts playwright.config.ts e2e"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
