  "components": {
    "schemas": {
      "FaultPatch": {
        "properties": {
          "paused": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 15000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "ack_loss_next": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ack Loss Next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FaultPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderCreate": {
        "properties": {
          "customer": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Customer",
            "default": "Ada Lovelace"
          },
          "product": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Product",
            "default": "Mechanical keyboard"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          },
          "unit_price_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Unit Price Cents",
            "default": 24900
          },
          "publish_gap": {
            "type": "boolean",
            "title": "Publish Gap",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "OrderCreate"
      },
      "RunCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "default": "Meu experimento"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario",
            "default": "healthy"
          },
          "max_attempts": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "default": 3
          },
          "retry_base_ms": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 100.0,
            "title": "Retry Base Ms",
            "default": 1000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunCreate"
      },
      "RunPatch": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paused"
        ],
        "title": "RunPatch"
      },
      "Scenario": {
        "type": "string",
        "enum": [
          "healthy",
          "retry",
          "dead_letter",
          "duplicate",
          "outbox_recovery",
          "direct_loss"
        ],
        "title": "Scenario"
      },
      "Service": {
        "type": "string",
        "enum": [
          "payment",
          "inventory",
          "notification"
        ],
        "title": "Service"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
